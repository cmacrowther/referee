# Runs referee-server-update.service every 6 hours.
#
# Enable:  sudo systemctl enable --now referee-server-update.timer

[Unit]
Description=Check for REFEREE relay server updates every 6 hours

[Timer]
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=1h
# Catch up on a check missed while the machine was off.
Persistent=true

[Install]
WantedBy=timers.target
