# Environment for referee-server.service.
#
# Install:  sudo install -D -m 0600 packaging/systemd/referee-server.env /etc/referee/referee-server.env
# Apply:    sudo systemctl restart referee-server

# API token for this server (at least 32 characters). Viewing devices store it
# when they link, so changing it later means linking each device again.
# Generate one with: openssl rand -hex 32
# Leave unset to use the generated token saved in config.json.
#REFEREE_API_TOKEN=

# Viewing devices allowed to link, comma-separated. Each entry is that
# device's relay origin:
#   https://peer-<instanceId>.referee.invalid
# Read a viewing device's instanceId on that device with:
#   curl -s http://localhost:14002/v1/ping
# Origins listed here are saved to approved-origins.json on startup; removing
# one from this file does not revoke it (use DELETE /v1/origins/{origin}).
#REFEREE_ALLOWED_ORIGINS=https://peer-00000000-0000-0000-0000-000000000000.referee.invalid

# Log filter (default: referee=info).
#RUST_LOG=referee=debug
