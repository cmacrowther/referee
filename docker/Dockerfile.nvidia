# =============================================================================
# Stage 1 — Builder
# Uses Debian bookworm (same as rust:1 default) so webkit2gtk-4.1 is available.
# tauri-build::build() runs as a Cargo build script and requires these headers
# even when the binary itself is headless.
# =============================================================================
FROM rust:1-bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    libayatana-appindicator3-dev \
    librsvg2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/desktop/native

# Preserve the repo-relative layout expected by tauri.conf.json paths like
# ../../assets/icons/... during headless Cargo builds.
COPY desktop/native/ /workspace/desktop/native/
COPY assets/ /workspace/assets/

RUN cargo build --features headless --bin referee-server --release

# =============================================================================
# Stage 2 — NVIDIA runtime
# Starts from plain Ubuntu (same as the AMD image) rather than nvidia/cuda.
# nvidia-container-toolkit injects libnvidia-encode and the Vulkan driver at
# runtime from the host driver stack — no CUDA base image required.
# NVIDIA_VISIBLE_DEVICES and NVIDIA_DRIVER_CAPABILITIES replace the env vars
# that nvidia/cuda would otherwise bake in.
# =============================================================================
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Tell nvidia-container-toolkit which driver capabilities to mount.
# "video"   — NVENC / NVDEC (libnvidia-encode, libnvcuvid)
# "utility" — nvidia-smi / management libs
# "graphics" — libGLX_nvidia.so.0 needed by the Vulkan ICD
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=video,utility,graphics

RUN apt-get update && apt-get install -y --no-install-recommends \
    # lspci — required by gpu.rs for GPU vendor/name detection
    pciutils \
    # TLS roots for outbound HTTPS (binary download, HLS probing)
    ca-certificates \
    # Debian bookworm ships OpenSSL 3 as libssl3
    libssl3 \
    # Vulkan loader — required by libplacebo for GPU-accelerated upscaling/tonemapping
    libvulkan1 \
    && rm -rf /var/lib/apt/lists/* \
    # Bake in the NVIDIA Vulkan ICD so libvulkan can discover the injected driver.
    # nvidia-container-toolkit mounts libGLX_nvidia.so.0 into /usr/local/nvidia/lib64
    # at runtime when NVIDIA_DRIVER_CAPABILITIES includes "graphics".
    # Note: this does not work on WSL2, which uses a different driver injection path.
    && mkdir -p /usr/share/vulkan/icd.d \
    && printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libGLX_nvidia.so.0","api_version":"1.3.0"}}\n' \
       > /usr/share/vulkan/icd.d/nvidia_icd.json

COPY --from=builder /workspace/desktop/native/target/release/referee-server /usr/local/bin/referee-server

# Run as a non-root user to limit the blast radius of a container escape.
# Pre-create the data/log directory and own it so the named volume is
# initialised with the correct ownership on first mount.
RUN groupadd -r referee && useradd -r -g referee -m -d /home/referee referee \
    && mkdir -p /home/referee/.local/share/com.referee.proxy \
    && chown -R referee:referee /home/referee/.local

EXPOSE 14002

# NVEncC .so files are copied by binary_manager into lib_dir at first run.
# /usr/local/nvidia/lib64 is where nvidia-container-toolkit injects the host
# driver libraries (libGLX_nvidia.so.0 etc.) that the Vulkan ICD requires.
ENV LD_LIBRARY_PATH="/home/referee/.local/share/com.referee.proxy/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64"

USER referee

CMD ["/usr/local/bin/referee-server"]
