{
    "productName": "REFEREE Upscaler",
    "version": "0.6.0",
    "identifier": "com.referee.proxy",
    "build": {
        "beforeBuildCommand": "npm run build:ui",
        "beforeDevCommand": "npm run dev:ui",
        "frontendDist": "../ui/dist",
        "devUrl": "http://localhost:5173"
    },
    "app": {
        "withGlobalTauri": false,
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:14002; img-src 'self' data:; media-src 'self' http://127.0.0.1:14002 blob:; worker-src 'self' blob:; font-src 'self' data:"
        }
    },
    "bundle": {
        "active": true,
        "resources": [],
        "icon": [
            "../../assets/icons/16x16.png",
            "../../assets/icons/32x32.png",
            "../../assets/icons/48x48.png",
            "../../assets/icons/64x64.png",
            "../../assets/icons/128x128.png",
            "../../assets/icons/256x256.png",
            "../../assets/icons/512x512.png",
            "../../assets/icons/icon.ico"
        ],
        "targets": [
            "nsis",
            "deb",
            "rpm"
        ],
        "windows": {
            "nsis": {
                "installMode": "perMachine",
                "installerHooks": "./nsis-hooks.nsi"
            }
        },
        "linux": {
            "appimage": {
                "bundleMediaFramework": false
            },
            "deb": {
                "section": "utility"
            },
            "rpm": {
                "epoch": 0,
                "release": "1"
            }
        }
    },
    "plugins": {
        "shell": {
            "open": true
        }
    }
}
